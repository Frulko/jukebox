{
  "id": "hotdog",
  "name": "Hot Dog Stand",
  "version": "1.0.0",
  "hostApi": "^1.0.0",
  "main": "index.mjs",
  "description": "Proof that a plugin can dress the whole app: a skin is a block of tokens in the manifest, and this one is the legendary Windows 3.1 colour scheme. Disable the plugin and the skin leaves the picker.",
  "author": "jukebox",
  "permissions": [],
  "contributes": {
    "theme": {
      "label": "Hot Dog",
      "rowHeight": 21,
      "tokens": {
        "--font": "\"Comic Sans MS\", \"Chalkboard SE\", cursive",
        "--fs": "12px",
        "--chrome": "#c40000",
        "--chrome-line": "#7a0000",
        "--chrome-text": "#ffff00",
        "--chrome-inset": "none",
        "--btn": "#ffff00",
        "--btn-line": "#7a0000",
        "--btn-text": "#c40000",
        "--btn-shadow": "none",
        "--btn-on": "#000",
        "--btn-on-line": "#000",
        "--btn-on-text": "#ffff00",
        "--sidebar": "#ffff00",
        "--sidebar-line": "#c40000",
        "--sidebar-text": "#000",
        "--sidebar-section": "#c40000",
        "--sidebar-sel": "#c40000",
        "--sidebar-sel-text": "#ffff00",
        "--sidebar-sel-shadow": "none",
        "--sidebar-shadow": "none",
        "--content": "#fffef0",
        "--text": "#000",
        "--dim": "#8a5a00",
        "--line": "#e0b000",
        "--line-soft": "#f0d060",
        "--head": "#c40000",
        "--head-line": "#7a0000",
        "--head-text": "#ffff00",
        "--head-sorted": "#a00000",
        "--stripe": "#fff7c8",
        "--sel": "#c40000",
        "--sel-text": "#ffff00",
        "--sel-blur": "#e0b000",
        "--row-h": "21px",
        "--row-radius": "0",
        "--lcd": "#ffff00",
        "--lcd-line": "#7a0000",
        "--lcd-shadow": "none",
        "--track-bg": "#e0b000",
        "--status": "#c40000",
        "--panel": "#fff7c8",
        "--field": "#fffef0",
        "--field-line": "#c40000",
        "--accent": "#c40000",
        "--focus": "rgba(196, 0, 0, .35)",
        "--menu": "#ffff00",
        "--menu-text": "#000",
        "--menu-line": "#c40000",
        "--star": "#c40000",
        "--star-off": "#e0b000",
        "--scroll-thumb": "#c40000",
        "--scroll-thumb-hover": "#7a0000",
        "--scroll-track": "#ffff00",
        "--radius": "0px"
      }
    }
  }
}
