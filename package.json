{
  "name": "jukebox",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @jukebox/server & npm run dev --workspace @jukebox/web",
    "dev:server": "npm run dev --workspace @jukebox/server",
    "dev:web": "npm run dev --workspace @jukebox/web",
    "build": "npm run build --workspaces --if-present",
    "check": "tsc -p packages/api-types && tsc -p packages/client-sdk && tsc -p apps/server && tsc -p apps/web",
    "test": "node scripts/test.mjs",
    "no-native": "node scripts/no-native.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/node": "^22.10.0"
  }
}
