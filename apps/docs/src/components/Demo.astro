---
import { url } from '../lib/url'

interface Props {
  /** The window's title bar text. */
  title?: string
  /** Shown under the window, in the page's voice. */
  note?: string
}
const { title = 'jukebox', note } = Astro.props

// The real front end, built from `apps/web` with `VITE_DEMO=1`. It is framed in
// an iframe rather than mounted here: it brings its own themes and its own
// keyboard handling, and neither should leak into the documentation around it.
const app = url('/app/')
---

<div class="window">
  <div class="window-bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="window-title">{title}</span>
    <span class="side">
      <span class="badge">demo</span>
      <a href={app} target="_blank" rel="noopener">open ↗</a>
    </span>
  </div>
  <iframe src={app} title="The jukebox interface" loading="lazy"></iframe>
</div>
{note && <p class="window-note">{note}</p>}
